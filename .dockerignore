# NOTE: one pattern per line, no trailing commas -- a trailing comma makes the
# pattern literal and silently stops it matching.

# Virtualenvs: each service has a local (Windows) .venv that must never be copied
# into a Linux image -- it would shadow the venv created by `uv sync`.
**/.venv

# Tool caches
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/__pycache__
**/*.py[cod]

# Build artifacts
**/dist
**/build
**/*.egg-info

# VCS / CI
.git
.gitignore
.github

# Secrets -- never bake into an image; supplied at runtime via env_file/environment
.env
**/.env
**/.db.env
**/.infisical.env

# Editor / OS noise
.idea
.vscode
**/.DS_Store

# Docs (README.md files are kept: hatchling reads `readme` from pyproject.toml)
docs
