# ---------------------------------------------------------------------------
# REQUIRED by the telegram containers (api, worker, migrate).
#
# Infisical machine-identity client secret. market_intel_lib.secrets.infisical
# reads it from the __INFISICAL_CLIENT_SECRET env var and authenticates with the
# client_id in market_intel_lib/settings/settings.toml. Without it those
# containers exit at import time.
# ---------------------------------------------------------------------------
INFISICAL_CLIENT_SECRET=
